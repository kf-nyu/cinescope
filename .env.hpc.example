# CineScope — NYU Dataproc / HDFS configuration
# Copy to .env on the Dataproc login node. Never commit .env.

CINESCOPE_STORAGE_BACKEND=hdfs
SPARK_MASTER=yarn

# Short NYU NetID only (no email domain). On Dataproc, prefer:
#   bash scripts/setup_hpc.sh
# which copies this file to .env and fills CINESCOPE_NETID from whoami
# (login user looks like ab1234_nyu_edu → CINESCOPE_NETID=ab1234).
# Or set manually, or leave blank to auto-detect from whoami at runtime.
# Paths: hdfs:///user/${CINESCOPE_NETID}_nyu_edu/cinescope-data
CINESCOPE_NETID=

# Optional override if your HDFS home is not <netid>_nyu_edu:
# CINESCOPE_HDFS_USER=

# Leave these blank to auto-fill from CINESCOPE_NETID (recommended).
# CINESCOPE_DATA_ROOT=
# SPARK_WAREHOUSE_DIR=
# SPARK_CHECKPOINT_DIR=
# SPARK_LOCAL_DIR=
# CINESCOPE_DOWNLOAD_STAGING=

# Namenode URI with authority (NOT bare hdfs://). Leave blank to auto-detect via:
#   hdfs getconf -confKey fs.defaultFS
# Example on NYU Dataproc:
# SPARK_HADOOP_FS_DEFAULT=hdfs://nyu-dataproc-m

# Cluster Spark install (Dataproc default). Used by make baseline / cast-crew / oscars.
# SPARK_HOME=/usr/lib/spark

SPARK_DRIVER_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=200
CINESCOPE_MIN_FREE_GB=0
